missions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"hrPersonId\",\"displayName\":\"HR person id\",\"group\":\"hr\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"},{\"name\":\"hr\",\"displayHeader\":\"Managed by HR\",\"displayDescription\":\"Kept in sync by the HR module; edit these in HR.\"}]}"]}}]},
