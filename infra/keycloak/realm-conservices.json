{
  "realm": "conservices",
  "enabled": true,
  "displayName": "Con Services (DEV)",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "emailTheme": "conservices",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@conservices.local",
    "fromDisplayName": "Con Services",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "editUsernameAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 36000,
  "ssoSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Org admin" },
      { "name": "member", "description": "Standard member" }
    ]
  },
  "groups": [
    { "name": "stash-admin", "path": "/stash-admin" },
    { "name": "stash-readonly", "path": "/stash-readonly" },
    { "name": "den-admin", "path": "/den-admin" },
    { "name": "events-admin", "path": "/events-admin" },
    { "name": "hr-admin", "path": "/hr-admin" }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Admin",
      "email": "admin@conservices.local",
      "credentials": [
        { "type": "password", "value": "adminadmin", "temporary": false }
      ],
      "groups": ["/stash-admin", "/den-admin", "/events-admin", "/hr-admin"],
      "realmRoles": ["admin", "member"]
    },
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Organizer",
      "email": "alice@conservices.local",
      "credentials": [
        { "type": "password", "value": "alicealice", "temporary": false }
      ],
      "groups": ["/stash-admin", "/events-admin", "/den-admin"],
      "realmRoles": ["member"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Volunteer",
      "email": "bob@conservices.local",
      "credentials": [
        { "type": "password", "value": "bobbob", "temporary": false }
      ],
      "groups": ["/stash-readonly"],
      "realmRoles": ["member"]
    },
    {
      "username": "service-account-hr-provisioner",
      "enabled": true,
      "serviceAccountClientId": "hr-provisioner",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm",
          "query-groups"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "stash-spa",
      "name": "Stash SPA",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "redirectUris": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "webOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
