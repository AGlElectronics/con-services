# Public event submission site (attendees). Production host is configuration,
# e.g. events.<convention-domain>.
submit.conservices.test {
	import hsts
	reverse_proxy events-submit:8080
}

mail.conservices.test {
	import hsts
	reverse_proxy mailpit:8025
}

db.conservices.test {
	import hsts
	reverse_proxy adminer:8080
}

# DEV S3 server (compose service "s3"). Presigned URLs are signed for
# s3:9000; keep that Host so signatures match.
s3.conservices.test {
	import hsts
	reverse_proxy s3:9000 {
		header_up Host {upstream_hostport}
	}
}
