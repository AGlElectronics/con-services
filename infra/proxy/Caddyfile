	reverse_proxy mailpit:8025
}

db.conservices.test {
	reverse_proxy adminer:8080
}

# Presigned URLs are signed for minio:9000; keep that Host so signatures match.
s3.conservices.test {
	reverse_proxy minio:9000 {
		header_up Host {upstream_hostport}
	}
}
