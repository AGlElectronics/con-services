# Local "production-like" entry point: https://<app>.conservices.test
# Certificates come from Caddy's own local CA (trust it once with
# scripts/setup-local-dns.ps1). Upstreams resolve at request time, so apps in
# compose profiles that are not running simply return 502.
{
	skip_install_trust
	# Own names so it is not confused with other Caddy CAs on the machine.
	pki {
		ca local {
			name "Con Services Local CA"
			root_cn "Con Services Local Root"
			intermediate_cn "Con Services Local Intermediate"
			intermediate_lifetime 90d
		}
	}
	# The 12h default expires overnight when the PC sleeps: Docker's VM is
	# suspended, renewal doesn't run, and the browser then refuses the login
	# server ("Failed to fetch"). Leaf certificates must expire before the
	# intermediate does.
	cert_issuer internal {
		ca local
		lifetime 30d
	}
}

auth.conservices.test {
	reverse_proxy keycloak:8080
}

