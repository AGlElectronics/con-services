# Development-only scaffold. OIDC is intentionally not enabled yet.
AUTH_MODE=dev
HTTP_ADDR=:8080

# Poll between once per minute and once every five minutes.
STATS_POLL_INTERVAL=2m
STATS_PULL_TIMEOUT=10s

# Comma-separated module=url entries. Empty starts the dashboard shell with
# no sources. Module endpoints must implement the documented internal contract.
STATS_SOURCES=

# Bearer token sent to every configured internal source. Dev-only example;
# use a secret manager and per-source credentials when production auth lands.
STATS_SERVICE_TOKEN=change-me-dev-only
