# Settings and secrets of compose.production.yml. Copy to .env next to it:
#
#   install -m 600 /dev/null .env && cat .env.example > .env
#
# .env holds secrets: mode 600, owned by the deploying user, never committed
# (.gitignore). Write it from your secret manager (OpenBao/Vault, SOPS,
# 1Password, ...) rather than typing values by hand; see
# https://aglelectronics.github.io/con-services/operations/secrets/#secrets-on-docker
# Every "change-me" must be replaced; Compose refuses to start while a
# required value is empty.
#
# Generate random values with:
#   passwords and tokens (letters and digits, safe in URLs): openssl rand -hex 32
#   DEN_LINK_ENCRYPTION_KEY values (32 bytes, base64):       openssl rand -base64 32

# --- Installation ----------------------------------------------------------
# Your domain: apps live on auth., den., hr., events., submit., stash.,
# finance., learn., wiki., desk., tasks. below it. auth-admin. is Keycloak's
# admin console.
DOMAIN=con.example.org
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=change-me@example.org
# Networks allowed to open https://auth-admin.<DOMAIN> (space-separated CIDRs).
ADMIN_ALLOWED_CIDRS=192.0.2.0/24
# Modules to run (Den always runs): hr, events, stash, finance, learn, wiki,
# desk, tasks. Each needs its values in the module section below.
COMPOSE_PROFILES=
# Releases (image tag MAJOR.MINOR.PATCH-BUILD, never latest). A module's MAJOR
# must equal Den's MAJOR.
DEN_VERSION=1.0.0-1
# HR_VERSION=1.0.0-1
# RALLY_VERSION=1.0.0-1
# STASH_VERSION=1.0.0-1
# FINANCE_VERSION=1.0.0-1
# LEARN_VERSION=1.0.0-1
# WIKI_VERSION=1.0.0-1
# DESK_VERSION=1.0.0-1
# TASKS_VERSION=1.0.0-1

# --- PostgreSQL (bundled, no published port) -------------------------------
POSTGRES_PASSWORD=change-me
DEN_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# --- Keycloak --------------------------------------------------------------
# Temporary admin "temp-admin" of the master realm (first start only).
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Client secrets: the realm import and the apps read the same value.
DEN_KEYCLOAK_CLIENT_SECRET=change-me
HR_PROVISIONER_CLIENT_SECRET=change-me
LEARN_PROVISIONER_CLIENT_SECRET=change-me
# Empty: Den does not keep the realm display name in line (generate the
# realm with --no-den-sync, then den-keycloak has no realm rights).
# DEN_KEYCLOAK_ADMIN_URL=

# --- Mail (Keycloak password resets; HR, Learn and Desk notices) ----------
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=no-reply@example.org
SMTP_FROM_NAME=Con Services
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me

# --- Object storage (managed S3) -------------------------------------------
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_USE_PATH_STYLE=true
# Den's bucket and a key with read and write on it only.
DEN_S3_BUCKET=example-conservices-den
DEN_S3_ACCESS_KEY_ID=change-me
DEN_S3_SECRET_ACCESS_KEY=change-me

# --- Den -------------------------------------------------------------------
OPERATOR_TOKEN=change-me
# age PUBLIC key(s) the backups are encrypted to (age-keygen prints
# "Public key: age1..."). Keep the secret half offline.
BACKUP_AGE_RECIPIENTS=age1change-me
BACKUP_TIMEZONE=Europe/Vienna
# Backups at ANOTHER provider or account than S3_ENDPOINT.
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_USE_PATH_STYLE=true
BACKUP_S3_BUCKET=example-conservices-backups
BACKUP_S3_ACCESS_KEY_ID=change-me
BACKUP_S3_SECRET_ACCESS_KEY=change-me
# true only if BACKUP_S3_ENDPOINT is the same S3 service as S3_ENDPOINT:
# Den then warns on its Backups page.
BACKUP_SAME_STORAGE_AS_DATA=false
# Read-only key on every module bucket, and the buckets to back up.
FILES_S3_ACCESS_KEY_ID=change-me
FILES_S3_SECRET_ACCESS_KEY=change-me
FILES_S3_BUCKETS=example-conservices-den

# --- Modules: fill in the block of every profile in COMPOSE_PROFILES -------
# Leave a block commented out while its module is off.

# HR (profile hr). Role catalogs and hooks: only the modules you run.
# HR_DB_PASSWORD=change-me
# HR_DEN_LINK_ENCRYPTION_KEY=change-me
# HR_ROLE_CATALOG_SOURCES=stash=http://stash-backend:8080/api/role-catalog,events=http://events-backend:8080/api/role-catalog
# HR_QUALIFICATION_CATALOG_SOURCES=learn=http://learn-backend:8080/api/qualification-catalog
# HR_LEARN_HOLDINGS_URL=http://learn-backend:8080/api/internal/holdings
# HR_OFFBOARD_HOOKS=http://wiki-backend:8080/api/internal/offboarded|<WIKI_SERVICE_TOKEN>
# HR_DEPARTMENT_HOOKS=http://tasks-backend:8080/api/internal/departments|<TASKS_SERVICE_TOKEN>

# Rally (profile events).
# EVENTS_DB_PASSWORD=change-me
# EVENTS_DEN_LINK_ENCRYPTION_KEY=change-me
# EVENTS_S3_BUCKET=example-conservices-rally
# EVENTS_S3_ACCESS_KEY_ID=change-me
# EVENTS_S3_SECRET_ACCESS_KEY=change-me
# RALLY_PUBLIC_API_BUILTIN_KEY=
# TELEGRAM_BOT_TOKEN=

# Stash (profile stash).
# STASH_DB_PASSWORD=change-me
# STASH_DEN_LINK_ENCRYPTION_KEY=change-me
# STASH_S3_BUCKET=example-conservices-stash
# STASH_S3_ACCESS_KEY_ID=change-me
# STASH_S3_SECRET_ACCESS_KEY=change-me

# Finance (profile finance).
# FINANCE_DB_PASSWORD=change-me
# FINANCE_DEN_LINK_ENCRYPTION_KEY=change-me

# Learn (profile learn). LEARN_SERVICE_TOKEN is shared with HR.
# LEARN_DB_PASSWORD=change-me
# LEARN_DEN_LINK_ENCRYPTION_KEY=change-me
# LEARN_S3_BUCKET=example-conservices-learn
# LEARN_S3_ACCESS_KEY_ID=change-me
# LEARN_S3_SECRET_ACCESS_KEY=change-me
# LEARN_SERVICE_TOKEN=change-me

# Wiki (profile wiki). WIKI_SERVICE_TOKEN is the token in HR_OFFBOARD_HOOKS.
# WIKI_DB_PASSWORD=change-me
# WIKI_DEN_LINK_ENCRYPTION_KEY=change-me
# WIKI_S3_BUCKET=example-conservices-wiki
# WIKI_S3_ACCESS_KEY_ID=change-me
# WIKI_S3_SECRET_ACCESS_KEY=change-me
# WIKI_SERVICE_TOKEN=change-me

# Desk (profile desk). DESK_SECRET_KEY encrypts stored mailbox passwords:
# never change it afterwards.
# DESK_DB_PASSWORD=change-me
# DESK_DEN_LINK_ENCRYPTION_KEY=change-me
# DESK_SECRET_KEY=change-me

# Tasks (profile tasks). TASKS_SERVICE_TOKEN is the token in HR_DEPARTMENT_HOOKS.
# TASKS_DB_PASSWORD=change-me
# TASKS_DEN_LINK_ENCRYPTION_KEY=change-me
# TASKS_S3_BUCKET=example-conservices-tasks
# TASKS_S3_ACCESS_KEY_ID=change-me
# TASKS_S3_SECRET_ACCESS_KEY=change-me
# TASKS_SERVICE_TOKEN=change-me
