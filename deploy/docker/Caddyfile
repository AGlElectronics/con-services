# Proxy of compose.production.yml: real certificates from Let's Encrypt for
# every host, HSTS on every response. DOMAIN, ACME_EMAIL and
# ADMIN_ALLOWED_CIDRS come from the proxy's environment (.env).
# Docs: https://aglelectronics.github.io/con-services/operations/docker-production/
{
	email {$ACME_EMAIL}
}

# HSTS: browsers use only HTTPS for these hosts for a year. CSP and the frame
# headers come from each web app's nginx (shared/nginx/security-headers.conf).
(common) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	encode zstd gzip
}

# Public sign-in: only what browsers and apps need. /admin, /metrics and
# /health stay off the internet (Keycloak's exposed path recommendations).
auth.{$DOMAIN} {
	import common
	@public path /realms/* /resources/*
	handle @public {
		reverse_proxy keycloak:8080
	}
	handle {
		respond 404
	}
}

# Keycloak's admin console, only from your admin networks.
auth-admin.{$DOMAIN} {
	import common
	@admins remote_ip {$ADMIN_ALLOWED_CIDRS}
	handle @admins {
		reverse_proxy keycloak:8080
	}
	handle {
		respond 403
	}
}

den.{$DOMAIN} {
	import common
	reverse_proxy den-frontend:8080
}

# Modules: answer 502 until their profile runs.
hr.{$DOMAIN} {
	import common
	reverse_proxy hr-frontend:8080
}

events.{$DOMAIN} {
	import common
	reverse_proxy events-frontend:8080
}

submit.{$DOMAIN} {
	import common
	reverse_proxy events-submit:8080
}

stash.{$DOMAIN} {
	import common
	reverse_proxy stash-frontend:8080
}

finance.{$DOMAIN} {
	import common
	reverse_proxy finance-frontend:8080
}

learn.{$DOMAIN} {
	import common
	reverse_proxy learn-frontend:8080
}

wiki.{$DOMAIN} {
	import common
	reverse_proxy wiki-frontend:8080
}

desk.{$DOMAIN} {
	import common
	reverse_proxy desk-frontend:8080
}

tasks.{$DOMAIN} {
	import common
	reverse_proxy tasks-frontend:8080
}
