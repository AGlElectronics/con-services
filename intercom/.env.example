HTTP_ADDR=:8080
DATABASE_URL=postgres://intercom:intercom@localhost:5432/intercom?sslmode=disable

# Prefer a dedicated staff bot. Falls back to TELEGRAM_BOT_TOKEN.
# INTERCOM_TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Board destination. Local Compose falls back to TELEGRAM_DEV_CATCHALL_*.
# INTERCOM_BOARD_CHAT_ID=-1003787521365
# INTERCOM_BOARD_THREAD_ID=599

# Optional separate forum topic for /idea (defaults to board thread).
# INTERCOM_IDEAS_THREAD_ID=

# Tasks bridge: /idea creates a card in Tasks → Intercom → Ideas.
TASKS_INTERNAL_URL=http://tasks-backend:8080
TASKS_SERVICE_TOKEN=tasks-service-dev-token
